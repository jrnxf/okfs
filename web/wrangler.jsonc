{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okfs-web",
  "compatibility_date": "2026-10-20",
  // Static files only: build.sh writes the page to dist.
  "assets": { "directory": "./dist" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "okfs.jrnxf.co", "custom_domain": true }],
}
